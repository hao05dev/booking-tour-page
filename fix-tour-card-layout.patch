+/* --- Tours Listing Card Compatibility Fix --- */
+/*
+ * The dynamic renderer in js/main.js uses a newer set of class names than
+ * the original card stylesheet. Keep the original rules intact and map the
+ * rendered classes here so the listing cards stay aligned and consistent.
+ */
+#toursListContainer .tour-card {
+  height: 100%;
+  min-width: 0;
+}
+
+#toursListContainer .tour-card-image-wrap {
+  position: relative;
+  aspect-ratio: 16 / 10;
+  overflow: hidden;
+  flex-shrink: 0;
+  background-color: var(--surface-alt);
+}
+
+#toursListContainer .tour-card-badges {
+  position: absolute;
+  top: 12px;
+  left: 12px;
+  z-index: 2;
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+  max-width: calc(100% - 64px);
+}
+
+#toursListContainer .tour-wishlist-btn {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  z-index: 3;
+  width: 36px;
+  height: 36px;
+  padding: 0;
+  border: none;
+  border-radius: var(--radius-full);
+  background-color: rgba(255, 255, 255, 0.94);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--text-muted);
+  cursor: pointer;
+  box-shadow: 0 3px 12px rgba(15, 23, 42, 0.12);
+  transition: var(--transition);
+}
+
+#toursListContainer .tour-wishlist-btn:hover,
+#toursListContainer .tour-wishlist-btn.active {
+  color: var(--danger);
+  background-color: #FFFFFF;
+  transform: scale(1.06);
+}
+
+#toursListContainer .tour-card-body {
+  min-width: 0;
+}
+
+#toursListContainer .tour-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 10px;
+  color: var(--text-muted);
+  font-size: 0.85rem;
+}
+
+#toursListContainer .tour-duration,
+#toursListContainer .tour-rating {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  white-space: nowrap;
+}
+
+#toursListContainer .tour-rating i {
+  color: var(--accent);
+}
+
+#toursListContainer .tour-title {
+  min-height: calc(1.4em * 2);
+  margin-bottom: 10px;
+  color: var(--text-main);
+  font-size: 1.05rem;
+  font-weight: 700;
+  line-height: 1.4;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+#toursListContainer .tour-title a {
+  color: inherit;
+  text-decoration: none;
+}
+
+#toursListContainer .tour-title a:hover {
+  color: var(--primary);
+}
+
+#toursListContainer .tour-description {
+  min-height: calc(1.6em * 3);
+  margin: 0 0 16px;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  line-height: 1.6;
+  display: -webkit-box;
+  -webkit-line-clamp: 3;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+#toursListContainer .tour-card-footer {
+  gap: 12px;
+  align-items: flex-end;
+}
+
+#toursListContainer .tour-price-box {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+#toursListContainer .tour-price-val {
+  color: var(--primary);
+  font-size: 1.15rem;
+  font-weight: 800;
+  line-height: 1.25;
+  white-space: nowrap;
+}
+
+#toursListContainer .tour-card-footer .btn {
+  flex-shrink: 0;
+  white-space: nowrap;
+}
+
+@media (max-width: 720px) {
+  #toursListContainer .tour-card-image-wrap {
+    aspect-ratio: 16 / 9;
+  }
+
+  #toursListContainer .tour-description,
+  #toursListContainer .tour-title {
+    min-height: 0;
+  }
+}
+
 /* --- Departure Cards --- */
 .departure-list {
   display: grid;
