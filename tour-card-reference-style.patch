diff --git a/css/style.css b/css/style.css
index be110e1..153243f 100644
--- a/css/style.css
+++ b/css/style.css
@@ -2581,3 +2581,232 @@ h1, h2, h3, h4, h5, h6 {
     top: 16px;
   }
 }
+
+/* ======================================================
+   TOUR LISTING - REFERENCE STYLE CARD
+   Inspired by the supplied travel-card reference while
+   preserving BookingTour's existing colors and data.
+   ====================================================== */
+#toursListContainer.tour-grid {
+  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
+  gap: 24px;
+  align-items: stretch;
+}
+
+#toursListContainer .tour-card-clickable {
+  color: inherit;
+  text-decoration: none;
+  border: 1px solid #D8DEE8;
+  border-radius: 20px;
+  background: #FFFFFF;
+  overflow: hidden;
+  box-shadow: 0 3px 10px rgba(15, 23, 42, 0.10);
+  cursor: pointer;
+  min-width: 0;
+  height: 100%;
+  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
+}
+
+#toursListContainer .tour-card-clickable:hover {
+  transform: translateY(-4px);
+  border-color: #CBD5E1;
+  box-shadow: 0 12px 26px rgba(15, 23, 42, 0.14);
+}
+
+#toursListContainer .tour-card-image-wrap {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 16 / 10;
+  overflow: hidden;
+  border-radius: 0;
+  background: #E2E8F0;
+}
+
+#toursListContainer .tour-card-img {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+#toursListContainer .tour-promo-badge {
+  position: absolute;
+  top: 18px;
+  left: 0;
+  z-index: 2;
+  display: inline-flex;
+  align-items: center;
+  min-height: 34px;
+  padding: 7px 13px;
+  border-radius: 0 7px 7px 0;
+  background: #EF4444;
+  color: #FFFFFF;
+  font-size: 0.82rem;
+  font-weight: 800;
+  line-height: 1;
+  text-transform: capitalize;
+  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);
+}
+
+#toursListContainer .tour-card-body {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+  padding: 18px 18px 16px;
+}
+
+#toursListContainer .tour-rating-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 32px;
+  margin-bottom: 14px;
+}
+
+#toursListContainer .tour-rating-score {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 52px;
+  height: 31px;
+  padding: 0 10px;
+  border-radius: 9px;
+  background: #34A853;
+  color: #FFFFFF;
+  font-size: 1rem;
+  font-weight: 800;
+  line-height: 1;
+}
+
+#toursListContainer .tour-rating-label {
+  color: #2F9E44;
+  font-size: 0.95rem;
+  font-weight: 700;
+}
+
+#toursListContainer .tour-rating-count {
+  color: #64748B;
+  font-size: 0.92rem;
+}
+
+#toursListContainer .tour-title {
+  display: -webkit-box;
+  min-height: calc(1.42em * 2);
+  margin: 0 0 16px;
+  overflow: hidden;
+  color: #1E293B;
+  font-size: 1.12rem;
+  font-weight: 700;
+  line-height: 1.42;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+#toursListContainer .tour-info-row {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px 16px;
+  margin-bottom: 16px;
+  color: #64748B;
+  font-size: 0.88rem;
+}
+
+#toursListContainer .tour-info-row span {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+}
+
+#toursListContainer .tour-info-row i {
+  color: #8B95A5;
+  font-size: 0.9rem;
+}
+
+#toursListContainer .tour-tag-row {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px;
+  margin-bottom: 18px;
+}
+
+#toursListContainer .tour-tag {
+  display: block;
+  min-width: 0;
+  padding: 8px 10px;
+  overflow: hidden;
+  border: 1px solid #E2E8F0;
+  border-radius: 8px;
+  background: #F8FAFC;
+  color: #334155;
+  font-size: 0.86rem;
+  line-height: 1.2;
+  text-align: center;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+#toursListContainer .tour-card-footer-reference {
+  display: flex;
+  justify-content: flex-end;
+  align-items: flex-end;
+  margin-top: auto;
+  padding-top: 16px;
+  border-top: 1px solid #E2E8F0;
+}
+
+#toursListContainer .tour-price-reference {
+  width: 100%;
+  text-align: right;
+}
+
+#toursListContainer .tour-price-line {
+  display: flex;
+  align-items: baseline;
+  justify-content: flex-end;
+  flex-wrap: wrap;
+  gap: 8px;
+  color: #64748B;
+  font-size: 0.91rem;
+}
+
+#toursListContainer .tour-price-line strong {
+  color: #F97316;
+  font-size: 1.26rem;
+  font-weight: 800;
+  line-height: 1.2;
+  white-space: nowrap;
+}
+
+#toursListContainer .tour-departure-date {
+  margin-top: 4px;
+  color: #64748B;
+  font-size: 0.86rem;
+}
+
+@media (max-width: 1199px) {
+  #toursListContainer.tour-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 760px) {
+  #toursListContainer.tour-grid {
+    grid-template-columns: 1fr;
+  }
+
+  #toursListContainer .tour-card-image-wrap {
+    aspect-ratio: 16 / 9;
+  }
+
+  #toursListContainer .tour-card-body {
+    padding: 16px;
+  }
+
+  #toursListContainer .tour-title {
+    min-height: 0;
+    font-size: 1.05rem;
+  }
+}
