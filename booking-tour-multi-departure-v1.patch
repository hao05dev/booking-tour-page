+
+.tour-accordion[open] > summary > i:last-child,
+.itinerary-day-accordion[open] > summary > i:last-child {
+  transform: rotate(180deg);
+}
+
+.tour-accordion-content {
+  padding: 0 18px 18px;
+}
+
+.tour-long-description {
+  margin: 0 0 16px;
+  color: var(--text-muted);
+  line-height: 1.75;
+}
+
+.tour-highlight-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 10px 18px;
+}
+
+.tour-highlight-grid > div {
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  font-size: 0.9rem;
+}
+
+.tour-highlight-grid i {
+  margin-top: 4px;
+  color: #10b981;
+}
+
+.itinerary-day-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.itinerary-day-accordion {
