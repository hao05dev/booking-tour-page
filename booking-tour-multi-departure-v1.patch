+
+/* ======================================================
+   TOUR DETAIL - DEPARTURE WORKSPACE, RELATED TOURS, ACCORDIONS
+   ====================================================== */
+.tour-booking-workspace {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 360px;
+  gap: 24px;
+  align-items: start;
+  margin-bottom: 32px;
+}
+
+.departure-picker-panel,
+.booking-request-panel,
+.tour-related-section,
+.tour-information-section,
+.tour-review-section {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow-sm);
+}
+
+.departure-picker-panel,
+.tour-related-section,
+.tour-information-section,
+.tour-review-section {
+  padding: 28px;
+}
+
+.tour-review-section {
+  margin-bottom: 32px;
+}
+
+.tour-section-heading {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 20px;
+}
+
+.tour-section-heading h2 {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  margin: 0 0 4px;
+  font-size: 1.35rem;
+}
+
+.tour-section-heading p {
+  margin: 0;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+}
+
+.departure-view-switch {
+  display: inline-flex;
+  gap: 4px;
+  padding: 4px;
+  border-radius: 10px;
+  background: var(--surface-alt);
+}
+
+.departure-view-switch span {
+  width: 38px;
+  height: 34px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 8px;
+  color: var(--text-muted);
+}
+
+.departure-view-switch span.active {
+  background: #fff;
+  color: var(--primary);
+  box-shadow: var(--shadow-sm);
+}
+
+.departure-month-tabs {
+  display: flex;
+  gap: 10px;
+  overflow-x: auto;
+  padding-bottom: 10px;
+  margin-bottom: 8px;
+  scrollbar-width: thin;
+}
+
+.departure-month-tab {
+  flex: 0 0 auto;
+  padding: 8px 16px;
+  border: 1px solid #cbd5e1;
+  border-radius: var(--radius-full);
+  background: #fff;
+  color: var(--text-main);
+  font-weight: 600;
+  cursor: pointer;
+  transition: var(--transition);
+}
+
+.departure-month-tab:hover,
+.departure-month-tab.active {
+  border-color: #06b6d4;
+  color: #0369a1;
+  background: #ecfeff;
+}
+
+.departure-schedule-list {
+  overflow: hidden;
+  border: 1px solid var(--border);
+  border-radius: 16px;
+}
+
+.departure-schedule-row {
+  display: grid;
+  grid-template-columns: 105px minmax(0, 1fr) 145px 112px;
+  align-items: center;
+  gap: 14px;
+  padding: 10px 14px;
+  background: #fff;
+  border-bottom: 1px solid var(--border);
+  transition: var(--transition);
+}
+
+.departure-schedule-row:last-child {
+  border-bottom: 0;
+}
+
+.departure-schedule-row:hover:not(.disabled) {
+  background: #f8fdff;
+}
+
+.departure-schedule-row.selected {
+  background: #ecfeff;
+  box-shadow: inset 4px 0 0 #06b6d4;
+}
+
+.departure-schedule-row.disabled {
+  opacity: 0.62;
+  background: #f8fafc;
+}
+
+.departure-date-tile {
+  min-height: 58px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  border-radius: 10px;
+  background: #f8fafc;
+}
+
+.departure-schedule-row.selected .departure-date-tile {
+  background: #cffafe;
+}
+
+.departure-date-tile span {
+  color: var(--text-muted);
+  font-size: 0.78rem;
+}
+
+.departure-date-tile strong {
+  color: #0f3f73;
+  font-size: 1.05rem;
+}
+
+.departure-trip-info {
+  min-width: 0;
+}
+
+.departure-trip-info > strong {
+  display: block;
+  color: var(--text-main);
+  font-size: 0.92rem;
+  line-height: 1.35;
+}
+
+.departure-confirmation {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  margin-top: 3px;
+  font-size: 0.8rem;
+}
+
+.departure-confirmation i {
+  font-size: 0.42rem;
+}
+
+.departure-confirmation.available { color: #059669; }
+.departure-confirmation.almost-full { color: #ea580c; }
+.departure-confirmation.sold-out { color: #dc2626; }
+
+.departure-row-price {
+  text-align: right;
+}
+
+.departure-row-price strong {
