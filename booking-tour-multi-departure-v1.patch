+
+.itinerary-day-accordion summary div > strong {
+  display: block;
+  margin-top: 4px;
+  color: #2d3748;
+  font-size: 1rem;
+}
+
+.itinerary-day-accordion summary div > small {
+  display: block;
+  margin-top: 4px;
+  color: var(--text-muted);
+}
+
+.itinerary-day-content {
+  padding: 0 16px 16px 172px;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  line-height: 1.7;
+}
+
+.tour-inclusion-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 24px;
+}
+
+.tour-inclusion-grid h4 {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 10px;
+}
+
+.tour-inclusion-grid ul {
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  padding-left: 18px;
+  list-style: disc;
+  color: var(--text-muted);
+  font-size: 0.88rem;
+}
+
+.tour-policy-note {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  color: var(--text-muted);
+  font-size: 0.9rem;
+  line-height: 1.65;
+}
+
+.tour-policy-note p {
+  margin: 0;
+}
+
+@media (max-width: 1050px) {
+  .tour-booking-workspace {
+    grid-template-columns: 1fr;
+  }
+
+  .booking-request-panel {
+    position: static;
+  }
+
+  .related-tour-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 760px) {
+  .departure-picker-panel,
+  .tour-related-section,
+  .tour-information-section,
+  .tour-review-section,
+  .booking-request-panel {
+    padding: 18px;
+  }
+
+  .departure-schedule-row {
+    grid-template-columns: 78px minmax(0, 1fr) 100px;
+    gap: 10px;
+  }
+
+  .departure-row-price {
+    text-align: left;
+  }
+
+  .departure-request-btn {
+    grid-column: 2 / -1;
+    width: 100%;
+  }
+
+  .related-tour-grid,
+  .tour-highlight-grid,
+  .tour-inclusion-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .itinerary-day-accordion > summary {
+    grid-template-columns: 86px minmax(0, 1fr) auto;
+    gap: 10px;
+    padding: 10px;
+  }
+
+  .itinerary-day-accordion img {
+    width: 86px;
+    height: 72px;
+  }
+
+  .itinerary-day-content {
+    padding: 0 12px 14px;
+  }
+}
+
+@media (max-width: 520px) {
+  .tour-section-heading {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .departure-schedule-row {
+    grid-template-columns: 70px minmax(0, 1fr);
+  }
+
+  .departure-row-price,
+  .departure-request-btn {
+    grid-column: 2;
+  }
+
+  .booking-request-status {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+}
