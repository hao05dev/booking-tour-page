   }
 }
 
+/* ======================================================
+   MANAGER - TOUR / MULTI-DEPARTURE WORKSPACE
+   ====================================================== */
+.manager-tour-row-active {
+  background: #f0fdfa;
+}
+
+.manager-departure-count {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 2px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--text-main);
+  text-align: left;
+  cursor: pointer;
+}
+
+.manager-departure-count strong {
+  color: var(--primary);
+  font-size: 0.9rem;
+}
+
+.manager-departure-count span {
+  color: var(--text-muted);
+  font-size: 0.72rem;
+}
+
+.manager-selected-tour {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  margin: 18px 0;
+  padding: 18px;
+  border: 1px solid #ccfbf1;
+  border-radius: 14px;
+  background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 68%);
+}
+
+.manager-selected-tour-main {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.manager-selected-tour-main img {
+  width: 78px;
+  height: 58px;
+  flex: 0 0 auto;
+  object-fit: cover;
+  border-radius: 10px;
+}
+
+.manager-selected-label {
+  display: block;
+  margin-bottom: 3px;
+  color: var(--primary);
+  font-size: 0.68rem;
+  font-weight: 800;
+  letter-spacing: 0.06em;
+}
+
+.manager-selected-tour-main h3 {
+  margin: 0;
+  max-width: 620px;
+  font-size: 1rem;
+}
+
+.manager-selected-tour-main p {
+  margin: 4px 0 0;
+  color: var(--text-muted);
+  font-size: 0.78rem;
+}
+
+.manager-selected-tour-stats {
+  flex: 0 0 auto;
+  display: grid;
+  grid-template-columns: repeat(3, minmax(95px, 1fr));
+  gap: 10px;
+}
+
+.manager-selected-tour-stats > div {
+  min-width: 95px;
+  padding: 10px 12px;
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  background: #fff;
+  text-align: center;
+}
+
+.manager-selected-tour-stats strong {
+  display: block;
+  color: var(--primary-dark);
+  font-size: 0.95rem;
+}
+
+.manager-selected-tour-stats span {
+  display: block;
+  margin-top: 2px;
+  color: var(--text-muted);
+  font-size: 0.68rem;
+}
+
+.manager-departure-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.manager-departure-card {
+  display: grid;
+  grid-template-columns: 160px minmax(0, 1fr) 150px auto;
+  align-items: center;
+  gap: 18px;
+  padding: 15px 16px;
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  background: #fff;
+  transition: var(--transition);
+}
+
+.manager-departure-card:hover {
+  border-color: #99f6e4;
+  box-shadow: var(--shadow-sm);
+}
+
+.manager-departure-date span,
+.manager-departure-date small,
+.manager-departure-price span {
+  display: block;
+  color: var(--text-muted);
+  font-size: 0.72rem;
+}
+
+.manager-departure-date strong {
+  display: block;
+  margin: 2px 0;
+  color: #0f3f73;
+  font-size: 1rem;
+}
+
+.manager-departure-topline {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px 14px;
+  margin-bottom: 8px;
+  color: var(--text-muted);
+  font-size: 0.78rem;
+}
+
+.manager-capacity-line {
+  display: grid;
+  grid-template-columns: auto minmax(100px, 1fr) auto;
+  align-items: center;
+  gap: 10px;
+}
+
+.manager-capacity-line > div:first-child {
+  display: flex;
+  align-items: baseline;
+  gap: 5px;
+}
+
+.manager-capacity-line strong {
+  color: var(--text-main);
+  font-size: 0.88rem;
+}
+
+.manager-capacity-line span,
+.manager-capacity-line small {
+  color: var(--text-muted);
+  font-size: 0.7rem;
+}
+
+.manager-capacity-progress {
+  height: 7px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: #e2e8f0;
+}
+
+.manager-capacity-progress span {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: var(--primary);
+}
+
+.manager-departure-price {
+  text-align: right;
+}
+
+.manager-departure-price strong {
+  display: block;
+  margin-top: 2px;
+  color: #f97316;
+  font-size: 1rem;
+}
+
+.manager-departure-actions {
+  display: flex;
+  gap: 6px;
+}
+
+.manager-departure-empty {
+  min-height: 180px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 28px;
+  border: 1px dashed #cbd5e1;
+  border-radius: 12px;
+  color: var(--text-muted);
+  text-align: center;
+}
+
+.manager-departure-empty i {
+  color: var(--primary);
+  font-size: 2rem;
+}
+
+.manager-departure-empty strong {
+  color: var(--text-main);
+}
+
+@media (max-width: 1100px) {
+  .manager-selected-tour {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .manager-selected-tour-stats {
+    width: 100%;
+  }
+
+  .manager-departure-card {
+    grid-template-columns: 140px minmax(0, 1fr) auto;
+  }
+
+  .manager-departure-price {
+    grid-column: 2;
+    text-align: left;
+  }
+
+  .manager-departure-actions {
+    grid-column: 3;
+    grid-row: 1 / span 2;
+  }
+}
+
+@media (max-width: 720px) {
+  .manager-selected-tour-stats {
+    grid-template-columns: 1fr;
+  }
+
+  .manager-departure-card {
+    grid-template-columns: 1fr;
+    gap: 10px;
+  }
+
+  .manager-departure-price,
+  .manager-departure-actions {
+    grid-column: 1;
+    grid-row: auto;
+    text-align: left;
+  }
+
+  .manager-capacity-line {
+    grid-template-columns: 1fr;
+  }
+}
diff --git a/css/pages.css b/css/pages.css
index 5f3b2d0..f1c93f2 100644
