+  color: var(--text-muted);
+  font-size: 0.74rem;
+  line-height: 1.45;
+  text-align: center;
+}
+
+.tour-related-section,
+.tour-information-section {
+  margin-bottom: 32px;
+}
+
+.related-tour-grid {
