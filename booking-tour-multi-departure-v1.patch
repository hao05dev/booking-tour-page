+}
+
+.itinerary-day-accordion > summary {
+  list-style: none;
+  display: grid;
+  grid-template-columns: 140px minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 16px;
+  padding: 12px 16px;
+  cursor: pointer;
+}
+
+.itinerary-day-accordion img {
+  width: 140px;
+  height: 88px;
+  object-fit: cover;
+  border-radius: 10px;
+}
+
+.itinerary-day-accordion summary div > span {
+  display: block;
+  color: #06a6c8;
+  font-size: 0.78rem;
