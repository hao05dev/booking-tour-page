+  padding: 22px;
+}
+
+.booking-request-header {
+  padding-bottom: 14px;
+  border-bottom: 1px solid var(--border);
+}
+
+.booking-request-header h3 {
+  margin: 0 0 12px;
+  font-size: 1.15rem;
+}
+
+.booking-selected-trip {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.booking-selected-trip strong {
+  color: #0f3f73;
+  font-size: 0.86rem;
+  line-height: 1.45;
+}
+
+.booking-change-date {
+  flex: 0 0 auto;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: #0284c7;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.booking-passenger-list {
+  margin-top: 8px;
+}
+
+.booking-passenger-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 16px 0;
+  border-bottom: 1px solid var(--border);
+}
+
+.booking-passenger-row > div:first-child {
+  min-width: 0;
+}
+
+.booking-passenger-row strong {
+  display: block;
+  font-size: 0.9rem;
+}
+
+.booking-passenger-row strong small {
+  color: var(--text-muted);
+  font-size: 0.72rem;
+  font-weight: 500;
+}
+
+.booking-passenger-row > div:first-child > span {
+  display: block;
+  margin-top: 2px;
+  color: #f97316;
+  font-size: 0.82rem;
+  font-weight: 700;
+}
+
+.booking-passenger-row .counter-controls {
+  gap: 10px;
+}
+
+.booking-passenger-row .counter-btn {
+  width: 36px;
+  height: 36px;
+  color: #64748b;
+  background: #fff;
+}
+
+.booking-passenger-row .counter-btn:hover:not(:disabled) {
+  background: #ecfeff;
+  color: #0369a1;
+  border-color: #06b6d4;
+}
+
+.booking-request-total {
+  padding: 18px 0 14px;
+}
+
+.booking-request-total > div:first-child,
+.booking-request-status {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.booking-request-total > div:first-child > span {
+  font-weight: 700;
+}
+
+.booking-request-total > div:first-child > strong {
+  color: #f97316;
+  font-size: 1.35rem;
+}
+
+.booking-request-status {
+  margin-top: 8px;
+  color: var(--text-muted);
+  font-size: 0.76rem;
+}
+
+.booking-request-status .text-danger {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  white-space: nowrap;
+}
+
+.booking-request-status .text-danger i {
+  font-size: 0.45rem;
+}
+
+.booking-request-panel .btn-accent {
+  background: #ff8800;
+  border-color: #ff8800;
+}
+
+.booking-request-panel .btn-accent:hover {
+  background: #ea7c00;
+  border-color: #ea7c00;
+}
+
+.booking-secure-note {
