+}
+
+.manager-week-day:last-child { border-right: none; }
+.manager-week-day.is-today { background: #f0fdfa; }
+
+.manager-week-day-header {
+  width: 100%;
+  padding: 8px 6px 12px;
+  border: none;
+  border-bottom: 1px solid var(--border);
