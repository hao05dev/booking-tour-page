+  border-radius: 999px;
+  font-size: 0.61rem;
+  font-weight: 800;
+}
+
+.manager-day-departure-kicker .is-start { background: #ccfbf1; color: #0f766e; }
+.manager-day-departure-kicker .is-running { background: #dbeafe; color: #2563eb; }
+.manager-day-departure-kicker .calendar-status-available { background: #dcfce7; color: #15803d; }
+.manager-day-departure-kicker .calendar-status-almost-full { background: #fef3c7; color: #b45309; }
+.manager-day-departure-kicker .calendar-status-sold-out { background: #fee2e2; color: #b91c1c; }
+
+.manager-day-departure-main h3 {
+  margin: 6px 0 3px;
+  font-size: 0.9rem;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.manager-day-departure-main p,
+.manager-day-departure-meta {
+  color: var(--text-muted);
+  font-size: 0.69rem;
+}
+
+.manager-day-departure-meta {
+  margin-top: 6px;
+}
+
+.manager-day-capacity {
+  height: 5px;
+  margin-top: 8px;
+  border-radius: 999px;
+  background: #e2e8f0;
+  overflow: hidden;
+}
+
+.manager-day-capacity span {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: linear-gradient(90deg, #0f766e, #14b8a6);
+}
+
+.manager-day-departure-side {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 5px;
+}
+
+.manager-day-departure-side > span {
+  color: var(--text-muted);
+  font-size: 0.66rem;
+}
+
+.manager-day-departure-side > strong {
+  color: #ea580c;
+  font-size: 0.95rem;
+}
+
+.manager-calendar-day-empty {
+  min-height: 360px;
+  padding: 50px 20px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+}
+
+.manager-calendar-day-empty-icon {
+  width: 58px;
+  height: 58px;
+  margin-bottom: 12px;
+  border-radius: 16px;
+  background: #f1f5f9;
+  color: #64748b;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.4rem;
+}
+
+.manager-calendar-day-empty h3 {
+  margin-bottom: 5px;
+  font-size: 1rem;
+}
+
+.manager-calendar-day-empty p {
+  margin-bottom: 14px;
+  color: var(--text-muted);
+  font-size: 0.8rem;
+}
+
+@media (max-width: 1100px) {
+  .manager-calendar-kpi-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .manager-calendar-toolbar,
+  .manager-calendar-shell-header {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .manager-calendar-legend {
+    justify-content: flex-start;
+  }
+}
+
+@media (max-width: 760px) {
+  .manager-calendar-filters,
+  .manager-day-summary {
+    grid-template-columns: 1fr;
+  }
+
+  .manager-calendar-kpi-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .manager-calendar-navigation {
+    width: 100%;
+    flex-wrap: wrap;
+  }
+
+  .manager-calendar-period-title {
+    min-width: 0;
+    width: 100%;
+    order: 10;
+    padding: 6px 0 0;
+  }
+
+  .manager-calendar-view-switch {
+    width: 100%;
+  }
+
+  .calendar-view-btn {
+    flex: 1;
+    justify-content: center;
+  }
+
+  .manager-day-departure-card {
+    grid-template-columns: 62px minmax(0, 1fr);
+  }
+
+  .manager-day-departure-card > img {
+    width: 62px;
+    height: 58px;
+  }
+
+  .manager-day-departure-side {
+    grid-column: 1 / -1;
+    padding-top: 10px;
+    border-top: 1px solid var(--border);
+    align-items: flex-start;
+  }
+}
