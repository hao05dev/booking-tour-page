+++ b/js/manager-calendar.js
@@ -0,0 +1,432 @@
+/* ==========================================================================
+   BOOKING TOUR - MANAGER OPERATIONS CALENDAR
+   Month / Week / Day visualization based on db.departures
+   ========================================================================== */
+
+function initManagerCalendar() {
+  const root = document.getElementById('managerCalendarRoot');
+  if (!root) return;
+
+  const db = getMockDatabase();
+  const periodTitle = document.getElementById('calendarPeriodTitle');
+  const tourFilter = document.getElementById('calendarTourFilter');
+  const guideFilter = document.getElementById('calendarGuideFilter');
+  const statusFilter = document.getElementById('calendarStatusFilter');
+  const searchInput = document.getElementById('calendarSearchInput');
+  const sidebarCount = document.getElementById('calendarSidebarDepartures');
+  const viewButtons = Array.from(document.querySelectorAll('[data-calendar-view]'));
+
+  const state = {
+    view: 'month',
+    focusDate: getInitialFocusDate(),
+    tourId: '',
+    guideId: '',
+    status: '',
+    keyword: ''
+  };
+
+  function parseVnDate(value) {
+    if (!value || value === 'Theo lịch trình') return null;
+    const [day, month, year] = value.split('/').map(Number);
+    if (!day || !month || !year) return null;
+    return new Date(year, month - 1, day, 12, 0, 0, 0);
+  }
+
+  function normalizeDate(date) {
+    return new Date(date.getFullYear(), date.getMonth(), date.getDate(), 12, 0, 0, 0);
+  }
+
+  function startOfWeek(date) {
+    const result = normalizeDate(date);
+    const day = result.getDay();
+    const diff = day === 0 ? -6 : 1 - day;
+    result.setDate(result.getDate() + diff);
+    return result;
+  }
+
+  function addDays(date, days) {
+    const result = normalizeDate(date);
+    result.setDate(result.getDate() + days);
+    return result;
+  }
+
+  function sameDay(a, b) {
+    return a && b
+      && a.getFullYear() === b.getFullYear()
+      && a.getMonth() === b.getMonth()
+      && a.getDate() === b.getDate();
+  }
+
+  function toIsoDate(date) {
+    const year = date.getFullYear();
+    const month = String(date.getMonth() + 1).padStart(2, '0');
+    const day = String(date.getDate()).padStart(2, '0');
+    return `${year}-${month}-${day}`;
+  }
+
+  function fromIsoDate(value) {
+    const [year, month, day] = value.split('-').map(Number);
+    return new Date(year, month - 1, day, 12, 0, 0, 0);
+  }
+
+  function formatDate(date) {
+    return new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
+  }
+
+  function formatShortDate(date) {
+    return new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit' }).format(date);
+  }
+
+  function formatWeekday(date, long = false) {
+    return new Intl.DateTimeFormat('vi-VN', { weekday: long ? 'long' : 'short' }).format(date);
+  }
+
+  function getInitialFocusDate() {
+    const today = normalizeDate(new Date());
+    const futureDepartures = db.departures
+      .map(dep => parseVnDate(dep.date))
+      .filter(Boolean)
+      .filter(date => date >= today)
+      .sort((a, b) => a - b);
+    return futureDepartures[0] || today;
+  }
+
+  function getTour(dep) {
+    return db.tours.find(tour => tour.id === dep.tourId) || null;
+  }
+
+  function getDepartureStatus(dep) {
+    const slots = Number(dep.slots || 0);
+    const maxSlots = Math.max(1, Number(dep.maxSlots || slots || 1));
+    if (slots <= 0) return { key: 'sold-out', label: 'Hết chỗ', className: 'calendar-status-sold-out' };
+    if (slots <= Math.max(3, Math.ceil(maxSlots * 0.2))) {
+      return { key: 'almost-full', label: 'Sắp hết chỗ', className: 'calendar-status-almost-full' };
+    }
+    return { key: 'available', label: 'Còn chỗ', className: 'calendar-status-available' };
+  }
+
+  function getDepartureRange(dep) {
+    const start = parseVnDate(dep.date);
+    const end = parseVnDate(dep.returnDate) || start;
+    return { start, end };
+  }
+
+  function overlapsDay(dep, date) {
+    const { start, end } = getDepartureRange(dep);
+    if (!start || !end) return false;
+    const target = normalizeDate(date).getTime();
+    return target >= start.getTime() && target <= end.getTime();
+  }
+
+  function overlapsRange(dep, rangeStart, rangeEnd) {
+    const { start, end } = getDepartureRange(dep);
+    if (!start || !end) return false;
+    return start <= rangeEnd && end >= rangeStart;
+  }
+
+  function populateFilters() {
+    if (tourFilter) {
+      tourFilter.innerHTML = '<option value="">Tất cả tour</option>' + db.tours
+        .map(tour => `<option value="${tour.id}">${tour.title}</option>`)
+        .join('');
+    }
+
+    if (guideFilter) {
+      const guides = new Map();
+      db.departures.forEach(dep => {
+        if (dep.guideId || dep.guideName) guides.set(dep.guideId || dep.guideName, dep.guideName || 'Chưa phân công');
+      });
+      guideFilter.innerHTML = '<option value="">Tất cả HDV</option>' + Array.from(guides.entries())
+        .map(([id, name]) => `<option value="${id}">${name}</option>`)
+        .join('');
+    }
+
+    if (sidebarCount) {
+      sidebarCount.textContent = `${db.departures.length} chuyến`;
+      sidebarCount.title = `${db.departures.length} chuyến khởi hành`;
+    }
+  }
+
+  function getFilteredDepartures() {
+    const keyword = state.keyword.trim().toLowerCase();
+    return db.departures.filter(dep => {
+      const tour = getTour(dep);
+      const status = getDepartureStatus(dep);
+      if (state.tourId && dep.tourId !== state.tourId) return false;
+      if (state.guideId && (dep.guideId || dep.guideName) !== state.guideId) return false;
+      if (state.status && status.key !== state.status) return false;
+      if (keyword) {
+        const searchable = `${tour?.title || ''} ${tour?.location || ''} ${dep.guideName || ''}`.toLowerCase();
+        if (!searchable.includes(keyword)) return false;
+      }
+      return true;
+    });
+  }
+
+  function getPeriodRange() {
+    if (state.view === 'day') {
+      const day = normalizeDate(state.focusDate);
+      return { start: day, end: day };
+    }
+    if (state.view === 'week') {
+      const start = startOfWeek(state.focusDate);
+      return { start, end: addDays(start, 6) };
+    }
+    return {
+      start: new Date(state.focusDate.getFullYear(), state.focusDate.getMonth(), 1, 12, 0, 0, 0),
+      end: new Date(state.focusDate.getFullYear(), state.focusDate.getMonth() + 1, 0, 12, 0, 0, 0)
+    };
+  }
+
+  function getPeriodTitle() {
+    if (state.view === 'day') {
+      const weekday = formatWeekday(state.focusDate, true);
+      return `${weekday.charAt(0).toUpperCase()}${weekday.slice(1)}, ${formatDate(state.focusDate)}`;
+    }
+    if (state.view === 'week') {
+      const { start, end } = getPeriodRange();
+      return `${formatShortDate(start)} - ${formatDate(end)}`;
+    }
+    return new Intl.DateTimeFormat('vi-VN', { month: 'long', year: 'numeric' }).format(state.focusDate)
+      .replace(/^./, char => char.toUpperCase());
+  }
+
+  function getActiveDeparturesOnDate(date, departures = getFilteredDepartures()) {
+    return departures
+      .filter(dep => overlapsDay(dep, date))
+      .sort((a, b) => {
+        const aStart = parseVnDate(a.date);
+        const bStart = parseVnDate(b.date);
+        const aStartsToday = sameDay(aStart, date) ? 0 : 1;
+        const bStartsToday = sameDay(bStart, date) ? 0 : 1;
+        return aStartsToday - bStartsToday || (aStart - bStart);
+      });
+  }
+
+  function updateKpis() {
+    const departures = getFilteredDepartures();
+    const { start, end } = getPeriodRange();
+    const periodDepartures = departures.filter(dep => overlapsRange(dep, start, end));
+    const tourCount = new Set(periodDepartures.map(dep => dep.tourId)).size;
+    const booked = periodDepartures.reduce((sum, dep) => sum + Math.max(0, Number(dep.maxSlots || 0) - Number(dep.slots || 0)), 0);
+    const capacity = periodDepartures.reduce((sum, dep) => sum + Number(dep.maxSlots || 0), 0);
+
+    let peakDate = null;
+    let peakCount = 0;
+    for (let cursor = normalizeDate(start); cursor <= end; cursor = addDays(cursor, 1)) {
+      const count = getActiveDeparturesOnDate(cursor, departures).length;
+      if (count > peakCount) {
+        peakCount = count;
+        peakDate = normalizeDate(cursor);
+      }
+    }
+
+    document.getElementById('calendarKpiDepartures').textContent = periodDepartures.length;
+    document.getElementById('calendarKpiDeparturesHint').textContent = `${periodDepartures.filter(dep => {
+      const startDate = parseVnDate(dep.date);
+      return startDate && startDate >= start && startDate <= end;
+    }).length} chuyến khởi hành trong kỳ`;
+    document.getElementById('calendarKpiTours').textContent = tourCount;
+    document.getElementById('calendarKpiBooked').textContent = booked;
+    document.getElementById('calendarKpiCapacity').textContent = `${capacity} tổng sức chứa`;
+    document.getElementById('calendarKpiPeak').textContent = peakDate ? formatShortDate(peakDate) : '--';
+    document.getElementById('calendarKpiPeakHint').textContent = peakDate ? `${peakCount} đoàn hoạt động cùng ngày` : 'Chưa có lịch trong kỳ';
+  }
+
+  function eventMarkup(dep, date, compact = false) {
+    const tour = getTour(dep);
+    const status = getDepartureStatus(dep);
+    const startDate = parseVnDate(dep.date);
+    const isStart = sameDay(startDate, date);
+    const capacityText = `${Math.max(0, Number(dep.maxSlots || 0) - Number(dep.slots || 0))}/${dep.maxSlots || 0}`;
+    const title = tour?.title || dep.tourTitle || 'Tour';
+    const location = tour?.location || 'Chưa cập nhật';
+
+    return `
+      <button type="button" class="calendar-event ${isStart ? 'calendar-event-start' : 'calendar-event-running'} ${status.className} ${compact ? 'is-compact' : ''}"
+        onclick="managerCalendarOpenDeparture('${dep.tourId}')" title="${title} · ${dep.date} - ${dep.returnDate || dep.date}">
+        <span class="calendar-event-dot"></span>
+        <span class="calendar-event-copy">
+          <strong>${isStart ? 'Khởi hành' : 'Đang tour'} · ${location}</strong>
+          ${compact ? '' : `<small>${capacityText} khách · ${dep.guideName || 'Chưa có HDV'}</small>`}
+        </span>
+      </button>
+    `;
+  }
+
+  function renderMonthView() {
+    const departures = getFilteredDepartures();
+    const monthStart = new Date(state.focusDate.getFullYear(), state.focusDate.getMonth(), 1, 12, 0, 0, 0);
+    const gridStart = startOfWeek(monthStart);
+    const today = normalizeDate(new Date());
+    const weekdayLabels = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'];
+
+    let html = `<div class="manager-month-calendar"><div class="manager-month-weekdays">${weekdayLabels.map(label => `<div>${label}</div>`).join('')}</div><div class="manager-month-grid">`;
+
+    for (let index = 0; index < 42; index += 1) {
+      const date = addDays(gridStart, index);
+      const active = getActiveDeparturesOnDate(date, departures);
+      const inMonth = date.getMonth() === state.focusDate.getMonth();
+      const loadClass = active.length >= 4 ? 'calendar-load-high' : active.length >= 2 ? 'calendar-load-medium' : active.length === 1 ? 'calendar-load-low' : '';
+      const visibleEvents = active.slice(0, 2);
+
+      html += `
+        <div class="manager-month-day ${inMonth ? '' : 'is-outside'} ${sameDay(date, today) ? 'is-today' : ''} ${loadClass}">
+          <div class="manager-month-day-header">
+            <button type="button" onclick="managerCalendarOpenDay('${toIsoDate(date)}')" class="manager-calendar-day-number">${date.getDate()}</button>
+            ${active.length ? `<span class="manager-calendar-day-count">${active.length} đoàn</span>` : ''}
+          </div>
+          <div class="manager-month-day-events">
+            ${visibleEvents.map(dep => eventMarkup(dep, date, true)).join('')}
+            ${active.length > 2 ? `<button type="button" class="manager-calendar-more" onclick="managerCalendarOpenDay('${toIsoDate(date)}')">+${active.length - 2} đoàn khác</button>` : ''}
+          </div>
+        </div>
+      `;
+    }
+
+    html += '</div></div>';
+    root.innerHTML = html;
+  }
+
+  function renderWeekView() {
+    const departures = getFilteredDepartures();
+    const start = startOfWeek(state.focusDate);
+    const today = normalizeDate(new Date());
+    let html = '<div class="manager-week-calendar">';
+
+    for (let index = 0; index < 7; index += 1) {
+      const date = addDays(start, index);
+      const active = getActiveDeparturesOnDate(date, departures);
+      html += `
+        <section class="manager-week-day ${sameDay(date, today) ? 'is-today' : ''}">
+          <button type="button" class="manager-week-day-header" onclick="managerCalendarOpenDay('${toIsoDate(date)}')">
+            <span>${formatWeekday(date).toUpperCase()}</span>
+            <strong>${date.getDate()}</strong>
+            <small>${active.length} đoàn</small>
+          </button>
+          <div class="manager-week-events">
+            ${active.length ? active.map(dep => eventMarkup(dep, date)).join('') : '<div class="manager-calendar-empty-mini">Không có đoàn</div>'}
+          </div>
+        </section>
+      `;
+    }
+
+    html += '</div>';
+    root.innerHTML = html;
+  }
+
+  function renderDayView() {
+    const departures = getActiveDeparturesOnDate(state.focusDate);
+    const totalBooked = departures.reduce((sum, dep) => sum + Math.max(0, Number(dep.maxSlots || 0) - Number(dep.slots || 0)), 0);
+
+    if (!departures.length) {
+      root.innerHTML = `
+        <div class="manager-calendar-day-empty">
+          <div class="manager-calendar-day-empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
+          <h3>Không có đoàn hoạt động trong ngày ${formatDate(state.focusDate)}</h3>
+          <p>Chuyển sang ngày khác hoặc tạo một chuyến khởi hành mới.</p>
+          <a href="manager-dashboard.html?action=new-departure" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Tạo chuyến khởi hành</a>
+        </div>
+      `;
+      return;
+    }
+
+    root.innerHTML = `
+      <div class="manager-day-summary">
+        <div><span>Ngày đang xem</span><strong>${formatDate(state.focusDate)}</strong></div>
+        <div><span>Đoàn hoạt động</span><strong>${departures.length}</strong></div>
+        <div><span>Khách đã giữ chỗ</span><strong>${totalBooked}</strong></div>
+      </div>
+      <div class="manager-day-list">
+        ${departures.map(dep => {
+          const tour = getTour(dep);
+          const status = getDepartureStatus(dep);
+          const { start } = getDepartureRange(dep);
+          const isStart = sameDay(start, state.focusDate);
+          const booked = Math.max(0, Number(dep.maxSlots || 0) - Number(dep.slots || 0));
+          const fill = dep.maxSlots ? Math.min(100, Math.round((booked / dep.maxSlots) * 100)) : 0;
+          return `
+            <article class="manager-day-departure-card">
+              <img src="${tour?.image || ''}" alt="${tour?.title || 'Tour'}">
+              <div class="manager-day-departure-main">
+                <div class="manager-day-departure-kicker"><span class="${isStart ? 'is-start' : 'is-running'}">${isStart ? 'Khởi hành hôm nay' : 'Đang trong hành trình'}</span><span class="${status.className}">${status.label}</span></div>
+                <h3>${tour?.title || dep.tourTitle || 'Tour'}</h3>
+                <p><i class="fa-solid fa-location-dot"></i> ${tour?.location || 'Chưa cập nhật'} · ${dep.date} → ${dep.returnDate || dep.date}</p>
+                <div class="manager-day-departure-meta"><span><i class="fa-solid fa-user-tie"></i> ${dep.guideName || 'Chưa phân công HDV'}</span><span><i class="fa-solid fa-users"></i> ${booked}/${dep.maxSlots || 0} khách</span></div>
+                <div class="manager-day-capacity"><span style="width:${fill}%"></span></div>
+              </div>
+              <div class="manager-day-departure-side">
+                <span>Giá / khách</span>
+                <strong>${formatCurrency(dep.price)}</strong>
+                <button type="button" class="btn btn-outline btn-sm" onclick="managerCalendarOpenDeparture('${dep.tourId}')">Quản lý <i class="fa-solid fa-arrow-right"></i></button>
+              </div>
+            </article>
+          `;
+        }).join('')}
+      </div>
+    `;
+  }
+
+  function render() {
+    if (periodTitle) periodTitle.textContent = getPeriodTitle();
+    viewButtons.forEach(button => button.classList.toggle('active', button.dataset.calendarView === state.view));
+    updateKpis();
+    if (state.view === 'week') renderWeekView();
+    else if (state.view === 'day') renderDayView();
+    else renderMonthView();
+  }
+
+  function movePeriod(direction) {
+    const next = normalizeDate(state.focusDate);
+    if (state.view === 'month') next.setMonth(next.getMonth() + direction);
+    else if (state.view === 'week') next.setDate(next.getDate() + (direction * 7));
+    else next.setDate(next.getDate() + direction);
+    state.focusDate = next;
+    render();
+  }
+
+  window.managerCalendarOpenDay = (isoDate) => {
+    state.focusDate = fromIsoDate(isoDate);
+    state.view = 'day';
+    render();
+    window.scrollTo({ top: document.getElementById('managerCalendarPage')?.offsetTop || 0, behavior: 'smooth' });
+  };
+
+  window.managerCalendarOpenDeparture = (tourId) => {
+    window.location.href = `manager-dashboard.html?tour=${encodeURIComponent(tourId)}&schedule=1#sectionTours`;
+  };
+
+  document.getElementById('calendarPrevBtn')?.addEventListener('click', () => movePeriod(-1));
+  document.getElementById('calendarNextBtn')?.addEventListener('click', () => movePeriod(1));
+  document.getElementById('calendarTodayBtn')?.addEventListener('click', () => {
+    state.focusDate = normalizeDate(new Date());
+    render();
+  });
+
+  viewButtons.forEach(button => {
+    button.addEventListener('click', () => {
+      state.view = button.dataset.calendarView;
+      render();
+    });
+  });
+
+  tourFilter?.addEventListener('change', () => { state.tourId = tourFilter.value; render(); });
+  guideFilter?.addEventListener('change', () => { state.guideId = guideFilter.value; render(); });
+  statusFilter?.addEventListener('change', () => { state.status = statusFilter.value; render(); });
+  searchInput?.addEventListener('input', () => { state.keyword = searchInput.value; render(); });
+
+  document.getElementById('calendarFilterReset')?.addEventListener('click', () => {
+    state.tourId = '';
+    state.guideId = '';
+    state.status = '';
+    state.keyword = '';
+    if (tourFilter) tourFilter.value = '';
+    if (guideFilter) guideFilter.value = '';
+    if (statusFilter) statusFilter.value = '';
+    if (searchInput) searchInput.value = '';
+    render();
+  });
+
+  populateFilters();
+  render();
+}
